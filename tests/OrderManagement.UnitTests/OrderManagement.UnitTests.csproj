<Project Sdk="Microsoft.NET.Sdk">

  <!-- Модульные тесты: xUnit + NSubstitute для подмены зависимостей -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <!-- Underscores intentionally separate Arrange/Act/Assert semantics in test names. -->
    <NoWarn>$(NoWarn);CA1707</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NSubstitute" />
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <!-- Веб-слой тестируется на уровне промежуточного ПО, поэтому нужен доступ к
       общему фреймворку ASP.NET Core (DefaultHttpContext, ProblemDetails). -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\OrderManagement.Application\OrderManagement.Application.csproj" />
    <ProjectReference Include="..\..\src\OrderManagement.WebApi\OrderManagement.WebApi.csproj" />
  </ItemGroup>

</Project>
